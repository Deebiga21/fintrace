# FinTrace AI Environment Configuration Example

# ===============================================
# Rust API Backend Configuration
# ===============================================
HOST=127.0.0.1
PORT=8000
RUST_LOG=info

# SQLite (Default Local Mode - zero external dependency setup)
DATABASE_URL=sqlite://../backend/fintrace.db

# PostgreSQL (Production / Docker Mode)
# DATABASE_URL=postgres://fintrace_admin:fintrace_secure_password_2026@127.0.0.1:5432/fintrace

# JWT Authentication
JWT_SECRET=fintrace-super-secure-investigator-secret-key-2026
JWT_EXPIRATION_HOURS=168

# Python ML Microservice URL
ML_SERVICE_URL=http://127.0.0.1:8001/api/v1

# ===============================================
# Python ML Microservice Configuration
# ===============================================
PYTHONUNBUFFERED=1
ML_PORT=8001
CUDA_VISIBLE_DEVICES=

# ===============================================
# Frontend Vite Configuration
# ===============================================
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
